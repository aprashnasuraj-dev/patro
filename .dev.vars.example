# Cloudflare Worker secrets. Copy to .dev.vars for local development only.
# Never commit .dev.vars. Production values belong in Cloudflare Workers Secrets.
#
# Core calendar, conversion, Community, Time Machine, On This Day and native/bundle
# Rashifal need no runtime secret beyond the committed bindings/non-secret vars.

# Media relay signing: configure at least one for signed FM/radio playback.
TV_RELAY_SECRET=
RADIO_RELAY_SECRET=

# Optional AI Jyotish providers: configure at least one provider key to enable AI chat.
Groq_API=
GROQ_API_KEY=
GROQ_KEY=
GROQ_MODEL=
nvidia_api=
NVIDIA_NIM_API_KEY=
NVIDIA_API_KEY=
NGC_API_KEY=
NVIDIA_MODEL=

# Optional account/private-state features.
GOOGLE_CLIENT_ID=

# Optional browser push.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Optional admin authorization. Configure subject IDs preferably; verified emails are fallback.
ADMIN_GOOGLE_SUBJECTS=
ADMIN_EMAILS=

# Optional enhancements/operator endpoints.
NASA_API_KEY=
CRON_SECRET=
RASHIFAL_SERVICE_TOKEN=

# Direct Supabase URL/anon/service-role/database credentials are intentionally not part of
# the Worker secret contract. Selective TV/FM/Samachar compatibility uses the non-secret
# SUPABASE_COMPAT_ORIGIN declared in wrangler.jsonc.

# Roadmap rollout flags (non-secret, default OFF). These are read by the Nepal Map static
# build and must stay 0 until the corresponding local verification gate is green.
ROADMAP_PROVENANCE_UI=0
NEPALMAP_SEARCH_WORKER=0
NEPALMAP_ROUTING_V2=0
NEPALMAP_STABLE_IDS=0
NEPALMAP_VISITOR_MODE=0

# Nepal Map build-time enhancement gates. All remain OFF until scripts/verify.sh is green.
NEPALMAP_BOUNDARY_CONFIDENCE=0
# Optional independent QA source; primary confidence comes from osm_wards.py's actual OSM polygons.
NEPAL_BOUNDARY_GEOJSON=
NEPAL_BOUNDARY_REVISION=
NEPAL_BOUNDARY_LICENSE=
NEPAL_BOUNDARY_AMBIGUOUS_KM=0.25
NEPAL_BOUNDARY_MEDIUM_KM=1
NEPALMAP_DETOUR_ROUTING=0
# Production target: valhalla-first-party. Keep fossgis-public only for explicit dev/fallback use.
NEPALMAP_ROUTING_PROVIDER=fossgis-public
NEPALMAP_ROAD_SAFETY=0
NEPALMAP_TERRAIN=0
# Required and must be same-origin when NEPALMAP_TERRAIN=1.
NEPALMAP_DEM_TILEJSON=
NEPALMAP_DEM_ATTRIBUTION=
NEPALMAP_OFFLINE_PACKS=0
NEPALMAP_EXPORTS=0
NEPALMAP_POI_PAGES=0
NEPALMAP_MAX_POI_PAGES=500
NEPALMAP_MOBILE_SHEET_V2=0
NEPALMAP_EMERGENCY=0
NEPALMAP_ITINERARY=0
NEPALMAP_CORRECTIONS_UI=0
NEPALMAP_PMTILES=0
NEPALMAP_PMTILES_ROADS=0
# Optional road GeoJSONSeq produced by scripts/explore/nepal/osm_roads.py for PMTiles build.
NEPALMAP_ROADS_NDJSON=
NEPALMAP_EMBEDS=0
NEPALMAP_SELF_HOST_MAPLIBRE=0
# Emits the 256-bucket static place lookup index consumed by /api/nepal/v1/place/:id.
NEPALMAP_API_BUILD=0

# Nepal Worker runtime gates. These are non-secret wrangler vars in production/preview and
# intentionally default OFF in wrangler.jsonc as well.
NEPAL_API_ENABLED=0
NEPAL_CORRECTIONS_ENABLED=0
NEPAL_EMERGENCY_ENABLED=0
# First-party routing requires NEPAL_API_ENABLED=1 as well.
NEPAL_ROUTING_ENABLED=0
NEPAL_ROUTING_ORIGIN=
# Secret shared only with the HTTPS auth gateway in front of loopback Valhalla.
NEPAL_ROUTING_TOKEN=
BIPAD_API_BASE=https://bipadportal.gov.np/api/v1
