{
  "name": "patro-day-atlas",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-09",
  "workers_dev": false,
  "services": [{"binding":"ORIGIN","service":"patro"}],
  "routes": [
    {"pattern":"aafnaipatro.com/atlas*","zone_name":"aafnaipatro.com"},
    {"pattern":"aafnaipatro.com/sitemap-atlas*","zone_name":"aafnaipatro.com"},
    {"pattern":"aafnaipatro.com/robots.txt","zone_name":"aafnaipatro.com"},
    {"pattern":"aafnaipatro.com/sitemap.xml","zone_name":"aafnaipatro.com"}
  ]
}
