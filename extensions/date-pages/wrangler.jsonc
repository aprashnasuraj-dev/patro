{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "patro-date-pages",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-30",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "../../.cloudflare/date-pages",
    "binding": "ASSETS",
    "not_found_handling": "none"
  },
  "services": [{"binding": "ORIGIN", "service": "patro"}],
  "observability": {"enabled": true}
}
