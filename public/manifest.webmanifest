  "lang": "ne",
  "start_url": "/astro/",
  "scope": "/astro/",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone",
    "minimal-ui"
  ],
  "background_color": "#0b0f19",
  "theme_color": "#0f172a",
  "orientation": "any",
