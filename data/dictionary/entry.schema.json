{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/nepali-lexicon.schema.json",
  "title": "Nepali lexicon file",
  "type": "object",
  "required": ["entries"],
  "properties": {
    "entries": { "type": "array", "items": { "$ref": "#/$defs/entry" } }
  },
  "$defs": {
    "pos": {
      "enum": ["noun", "pronoun", "adjective", "verb", "adverb", "postposition", "conjunction", "interjection", "particle", "numeral", "phrase"]
    },
    "deva": { "type": "string", "pattern": "^[\\u0900-\\u097F\\u200C\\u200D\\s-]+$" },
    "example": {
      "type": "object",
      "required": ["ne"],
      "properties": {
        "ne": { "type": "string", "minLength": 2 },
        "en": { "type": "string" },
        "source": { "type": "string" }
      },
      "additionalProperties": false
    },
    "sense": {
      "type": "object",
      "required": ["id", "pos", "ne"],
      "properties": {
        "id": { "type": "string", "pattern": "^s[0-9]+$" },
        "pos": { "$ref": "#/$defs/pos" },
        "ne": { "type": "string", "minLength": 2 },
        "en": { "type": "array", "items": { "type": "string" } },
        "register": { "enum": ["neutral", "literary", "colloquial", "honorific", "archaic", "slang", "technical"] },
        "domain": { "type": "string" },
        "examples": { "type": "array", "items": { "$ref": "#/$defs/example" } },
        "usageNote": { "type": "string" }
      },
      "additionalProperties": false
    },
    "entry": {
      "type": "object",
      "required": ["lemma", "senses"],
      "properties": {
        "lemma": { "$ref": "#/$defs/deva" },
        "homograph": { "type": "integer", "minimum": 2 },
        "roman": { "type": "string", "pattern": "^[a-z ]+$" },
        "romanAlt": { "type": "array", "items": { "type": "string" } },
        "variants": { "type": "array", "items": { "$ref": "#/$defs/deva" } },
        "senses": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sense" } },
        "synonyms": { "type": "array", "items": { "$ref": "#/$defs/deva" } },
        "antonyms": { "type": "array", "items": { "$ref": "#/$defs/deva" } },
        "related": { "type": "array", "items": { "$ref": "#/$defs/deva" } },
        "etymology": {
          "type": "object",
          "required": ["origin"],
          "properties": {
            "origin": { "enum": ["tatsam", "tadbhav", "aagantuk", "deshaj", "unknown"] },
            "from": { "type": "string" },
            "lang": { "type": "string" },
            "note": { "type": "string" }
          },
          "additionalProperties": false
        },
        "ipa": { "type": "string" },
        "audio": { "type": "string" },
        "categories": { "type": "array", "items": { "type": "string" } },
        "freq": { "type": "integer", "minimum": 1 },
        "status": { "enum": ["draft", "reviewed", "published"] },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "license"],
            "properties": { "name": { "type": "string" }, "license": { "type": "string" }, "url": { "type": "string" } }
          }
        },
        "updatedAt": { "type": "string" }
      },
      "additionalProperties": false
    }
  }
}
