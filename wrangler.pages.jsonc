{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mero-patro-pages",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-09-30",
  "services": [
    {
      "binding": "PATRO_API",
      "service": "mero-patro"
    }
  ],
  "vars": {
    "PUBLIC_SITE_URL": "https://patro-blush.vercel.app"
  }
}
