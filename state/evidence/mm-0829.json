    {
      "id": "s1",
      "title": "Numbers of Word Associations to Color Patches and Color Names Differ across Two Opponent Pairs",
      "publisher": "SAGE Publications",
      "author": "Smith, Greg; Day, H. D.",
      "published_at": "1983-08",
      "url": "https://doi.org/10.2466/pms.1983.57.1.233",
      "retrieved_at": "2026-10-18T15:38:26.086Z",
      "sha256": "e4cfd0e6979dcf5f5dd76595e058ccdb5dfa3dfeb2cac8391c14226b88422e03",
      "rendered": false,
      "scraped": false,
      "excerpts": [
        "68 female undergraduate students completed word-association and semantic-differential tasks in response to stimuli which were patches or names of eight colors.",
        "The number of word associations for the group viewing color patches differed from that of the group responding to color names on the basis of four colors forming two of the three opponent pairs of the opponent-process theory of color vision."
      ]
    },
