    {
      "id": "s5",
      "title": "How a tariff-based trade policy affects domestic prices, import volumes and welfare: an empirical analysis of the eu´s retaliatory tariffs on the Us",
      "publisher": "New University of Lisbon's Repository (New University of Lisbon)",
      "author": "Zoe Rabea Berg",
