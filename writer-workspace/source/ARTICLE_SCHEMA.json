{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "title": "MissionMangalArticle",
 "type": "object",
 "required": [
  "id",
  "slug",
  "canonical_url",
  "title",
  "meta_description",
  "h1",
  "category",
  "author",
  "published",
  "key_takeaways",
  "sections",
  "faq",
  "sources",
  "word_count",
  "reading_minutes",
  "image",
  "keywords"
 ],
 "properties": {
  "id": {
   "type": "string"
  },
  "slug": {
   "type": "string",
   "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
   "maxLength": 60
  },
  "canonical_url": {
   "type": "string",
   "pattern": "^https://aafnaipatro\\.com/[a-z0-9-]+/$"
  },
  "title": {
   "type": "string",
   "maxLength": 60
  },
  "meta_description": {
   "type": "string",
   "minLength": 110,
   "maxLength": 160
  },
  "h1": {
   "type": "string"
  },
  "category": {
   "type": "string"
  },
  "author": {
   "type": "string"
  },
  "published": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
  },
  "keywords": {
   "type": "array",
   "minItems": 4,
   "maxItems": 8,
   "items": {
    "type": "string"
   }
  },
  "key_takeaways": {
   "type": "array",
   "minItems": 4,
   "maxItems": 4,
   "items": {
    "type": "string"
   }
  },
  "sections": {
   "type": "array",
   "minItems": 8,
   "maxItems": 10,
   "items": {
    "type": "object",
    "required": [
     "h2",
     "paras"
    ],
    "properties": {
     "h2": {
      "type": "string"
     },
     "paras": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
       "type": "string",
       "minLength": 60
      }
     }
    }
   }
  },
  "faq": {
   "type": "array",
   "minItems": 4,
   "maxItems": 6,
   "items": {
    "type": "object",
    "required": [
     "q",
     "a"
    ],
    "properties": {
     "q": {
      "type": "string"
     },
     "a": {
      "type": "string",
      "pattern": "\\[\\d+\\]"
     }
    }
   }
  },
  "sources": {
   "type": "array",
   "minItems": 3,
   "items": {
    "type": "object",
    "required": [
     "n",
     "title",
     "publisher",
     "url",
     "retrieved_at"
    ],
    "properties": {
     "n": {
      "type": "integer",
      "minimum": 1
     },
     "title": {
      "type": "string"
     },
     "publisher": {
      "type": "string"
     },
     "url": {
      "type": "string",
      "pattern": "^https://"
     },
     "published_at": {
      "type": [
       "string",
       "null"
      ]
     },
     "retrieved_at": {
      "type": "string"
     }
    }
   }
  },
  "word_count": {
   "type": "integer",
   "minimum": 1000
  },
  "reading_minutes": {
   "type": "integer",
   "minimum": 1
  },
  "image": {
   "type": [
    "object",
    "null"
   ],
   "required": [
    "file",
    "alt",
    "credit",
    "license",
    "width",
    "height"
   ],
   "properties": {
    "file": {
     "type": "string",
     "pattern": "^[a-z0-9-]+-hero\\.(png|jpg|jpeg|webp)$"
    },
    "alt": {
     "type": "string",
     "minLength": 20,
     "maxLength": 160
    },
    "caption": {
     "type": "string"
    },
    "credit": {
     "type": "string"
    },
    "license": {
     "type": "string"
    },
    "source_url": {
     "type": "string"
    },
    "width": {
     "const": 1200
    },
    "height": {
     "const": 630
    }
   }
  }
 }
}