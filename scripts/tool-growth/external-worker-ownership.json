{
  "schemaVersion": 1,
  "purpose": "Prevent the main patro Worker and tool SEO release from claiming foreign-repository Worker routes or branded domains.",
  "root": {
    "hostname": "aafnaipatro.com",
    "worker": "patro",
    "main": "worker/optimized-entry.ts"
  },
  "foreignRoutes": [
    {
      "pattern": "aafnaipatro.com/atlas*",
      "script": "patro-day-atlas"
    },
    {
      "pattern": "aafnaipatro.com/sitemap-atlas*",
      "script": "patro-day-atlas"
    },
    {
      "pattern": "aafnaipatro.com/sitemap-library.xml",
      "script": "aafnai-library-phase1"
    },
    {
      "pattern": "aafnaipatro.com/research/*",
      "script": "aafnai-library-phase1"
    },
    {
      "pattern": "aafnaipatro.com/article/*",
      "script": "aafnai-library-phase1"
    },
    {
      "pattern": "aafnaipatro.com/blogs/*",
      "script": "aafnai-library-phase1"
    },
    {
      "pattern": "aafnaipatro.com/library*",
      "script": "aafnai-library-phase1"
    },
    {
      "pattern": "aafnaipatro.com/date/*",
      "script": "patro-adsterra-gateway",
      "backendScript": "patro-date-pages"
    }
  ],
  "foreignCustomDomains": [
    {
      "hostname": "bali-tools.aafnaipatro.com",
      "service": "aafnai-growth-bali-preview"
    },
    {
      "hostname": "global-tools.aafnaipatro.com",
      "service": "aafnai-growth-dst-western"
    },
    {
      "hostname": "sitemaps.aafnaipatro.com",
      "service": "aafnai-growth-sitemaps"
    },
    {
      "hostname": "renovation-quotes.aafnaipatro.com",
      "service": "aafnai-renovation-quotes-v10"
    },
    {
      "hostname": "uposatha.aafnaipatro.com",
      "service": "aafnai-uposatha-companion-v10"
    },
    {
      "hostname": "school-transfer.aafnaipatro.com",
      "service": "aafnai-school-transfer-v11"
    },
    {
      "hostname": "heat-rules.aafnaipatro.com",
      "service": "aafnai-product-platform-v1"
    }
  ],
  "reservedPrefixes": [
    "/article/",
    "/blogs/",
    "/research/",
    "/library",
    "/date/",
    "/atlas",
    "/sitemap-atlas",
    "/sitemap-library.xml"
  ],
  "adsterraGateway": {
    "worker": "patro-adsterra-gateway",
    "routes": [
      "aafnaipatro.com/tools*",
      "aafnaipatro.com/advancetools*",
      "aafnaipatro.com/nepal*",
      "aafnaipatro.com/calculator*",
      "aafnaipatro.com/converter*",
      "aafnaipatro.com/utilities*",
      "aafnaipatro.com/generator*",
      "aafnaipatro.com/validator*",
      "aafnaipatro.com/editor*",
      "aafnaipatro.com/planner*",
      "aafnaipatro.com/extractor*",
      "aafnaipatro.com/analyzer*",
      "aafnaipatro.com/formatter*",
      "aafnaipatro.com/comparison*",
      "aafnaipatro.com/timer*",
      "aafnaipatro.com/client-tools*",
      "aafnaipatro.com/moon*",
      "aafnaipatro.com/eclipse*",
      "aafnaipatro.com/weather*",
      "aafnaipatro.com/us/*",
      "aafnaipatro.com/de/*",
      "aafnaipatro.com/fr/*",
      "aafnaipatro.com/es/*",
      "aafnaipatro.com/it/*",
      "aafnaipatro.com/_mm530*",
      "aafnaipatro.com/nepalmap*",
      "aafnaipatro.com/date/*"
    ],
    "backendServices": [
      "patro",
      "patro-date-pages"
    ]
  }
}
