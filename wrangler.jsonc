{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mero-patro",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-30",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/*",
      "!/astro/assets/*"
    ]
  },
  "vars": {
    "SUPABASE_COMPAT_ORIGIN": "https://pxlsmxbpgdfzjzuqtict.supabase.co/functions/v1/router",
    "SUPABASE_PROTECTED_ORIGIN": "https://pxlsmxbpgdfzjzuqtict.supabase.co/functions/v1/nepal-miti-protected",
    "CALENDAR_COVERAGE_START": "1826-04-11",
    "CALENDAR_COVERAGE_END": "2037-04-13",
    "CALENDAR_SOURCE_VERSION": "patro-archive-v79"
  },
  "observability": {
    "enabled": true
  }
}
