{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "patro",
  "main": "worker/optimized-entry.ts",
  "compatibility_date": "2026-09-30",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "keep_vars": true,
  "preview_urls": false,
  "ai": {
    "binding": "AI"
  },
  "routes": [
    {
      "pattern": "aafnaipatro.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": [
      "/*",
      "!/assets/*",
      "!/manifest.webmanifest",
      "!/pwa-install-early.js",
      "!/sw.js",
      "!/patro-boot-recovery.js",
      "!/icon-192.png",
      "!/icon-512.png",
      "!/maskable-512.png",
      "!/apple-touch-icon.png",
      "!/favicon.svg",
      "!/favicon.ico",
      "!/moon",
      "!/moon/*",
      "!/eclipse",
      "!/eclipse/*",
      "!/nepal",
      "!/nepal/time",
      "!/nepal/year",
      "!/nepal/trek-weather",
      "!/nepal/trek-weather/*",
      "!/nepalmap",
      "!/nepalmap/*",
      "!/sitemap-nepalmap.xml",
      "!/us/*",
      "!/weather",
      "!/weather/*",
      "!/de/*",
      "!/fr/*",
      "!/es/*",
      "!/it/*",
      "!/sitemap-growth.xml",
      "!/aap/runtime.js",
      "!/aap/analytics.js",
      "!/data/*",
      "!/advancetools",
      "!/advancetools/",
      "!/advancetools/index.html",
      "!/advancetools/sitemap.xml",
      "!/advancetools/module-manifest.json",
      "!/advancetools/assets",
      "!/advancetools/assets/*",
      "!/advancetools/downloads",
      "!/advancetools/downloads/*",
      "!/advancetools/licenses",
      "!/advancetools/licenses/*",
      "!/advancetools/methodology",
      "!/advancetools/methodology/*",
      "!/advancetools/knittingcalculators",
      "!/advancetools/knittingcalculators/*",
      "!/advancetools/chordlibrary",
      "!/advancetools/chordlibrary/*",
      "!/advancetools/workshopreference",
      "!/advancetools/workshopreference/*",
      "!/advancetools/fontconverters",
      "!/advancetools/fontconverters/*",
      "!/advancetools/printablepaper",
      "!/advancetools/printablepaper/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "patro",
      "database_id": "fb25c860-01db-4ab0-9036-7f87b26ca64b",
      "migrations_dir": "cloudflare/d1/schema-migrations"
    }
  ],
  "vars": {
    "GOOGLE_CLIENT_ID": "1057768734502-0on6v9gor3in7k09i0b1js1jp2iauk29.apps.googleusercontent.com",
    "PUBLIC_SITE_URL": "https://aafnaipatro.com",
    "SUPABASE_COMPAT_ORIGIN": "https://pxlsmxbpgdfzjzuqtict.supabase.co/functions/v1/router",
    "CALENDAR_COVERAGE_START": "1826-04-11",
    "CALENDAR_COVERAGE_END": "2037-04-13",
    "CALENDAR_SOURCE_VERSION": "patro-archive-v79",
    "PUBLIC_REFERENCE_CACHE_VERSION": "public-reference-v1"
  },
  "triggers": {
    "crons": [
      "*/5 * * * *",
      "43 2 * * *",
      "11 3 * * *",
      "15 18 * * *"
    ]
  },
  "observability": {
    "enabled": true
  }
}
