{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mission Mangal evidence-first article package",
  "type": "object",
  "required": [
    "id",
    "title",
    "intent",
    "status",
    "sources",
    "claims",
    "media",
    "original_contribution"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 3
    },
    "title": {
      "type": "string",
      "minLength": 12
    },
    "intent": {
      "type": "string",
      "minLength": 12
    },
    "status": {
      "enum": [
        "draft",
        "blocked",
        "review",
        "approved"
      ]
    },
    "original_contribution": {
      "type": "string",
      "minLength": 30
    },
    "sources": {
      "type": "array",
      "minItems": 5,
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "id",
          "url",
          "title",
          "publisher",
          "retrieved_at",
          "verified",
          "claim_ids"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "title": {
            "type": "string",
            "minLength": 3
          },
          "publisher": {
            "type": "string",
            "minLength": 2
          },
          "retrieved_at": {
            "type": "string",
            "format": "date-time"
          },
          "verified": {
            "const": true
          },
          "claim_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "license": {
            "type": "string"
          },
          "published_at": {
            "type": "string"
          },
          "snapshot_hash": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "text",
          "source_ids"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "text": {
            "type": "string",
            "minLength": 8
          },
          "source_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "media": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "type",
          "url",
          "alt",
          "credit",
          "license",
          "rights_verified"
        ],
        "properties": {
          "type": {
            "enum": [
              "image",
              "chart",
              "diagram",
              "video",
              "audio"
            ]
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "alt": {
            "type": "string",
            "minLength": 8
          },
          "credit": {
            "type": "string",
            "minLength": 2
          },
          "license": {
            "type": "string",
            "minLength": 2
          },
          "rights_verified": {
            "const": true
          },
          "transcript_url": {
            "type": "string"
          }
        }
      }
    }
  },
  "additionalProperties": true
}
