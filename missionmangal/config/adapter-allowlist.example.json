{
  "version": 1,
  "enabled": false,
  "notes": "Template only. Copy reviewed entries into adapter-allowlist.json after verifying current provider terms, commercial use, model ID, limits, and adding matching GitHub Actions secrets. Never commit secret values. Do not set the verification flags to true without review.",
  "adapters": [
    {
      "id": "gemini-flash",
      "kind": "gemini",
      "endpoint": "https://generativelanguage.googleapis.com/v1beta",
      "model": "gemini-2.5-flash",
      "secret_env": "GEMINI_API_KEY",
      "capabilities": [
        "draft",
        "edit",
        "review"
      ],
      "daily_limit": 100,
      "enabled": false,
      "official_terms_verified": false,
      "commercial_use_verified": false,
      "max_retries": 2,
      "timeout_seconds": 40
    },
