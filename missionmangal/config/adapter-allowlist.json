{
  "version": 1,
  "enabled": true,
  "notes": "Owner-attested 2026-10-18: the site owner accepts each provider's terms. Adapters only run when their secret exists. model:'auto' discovers a current chat model from the provider's /models list at run time.",
  "adapters": [
    {
      "id": "groq",
      "endpoint": "https://api.groq.com/openai/v1/chat/completions",
      "model": "auto",
      "prefer": [
        "llama-3\\.3-70b",
        "llama-3\\.1-70b",
        "gpt-oss-120b",
        "70b"
      ],
      "secret_env": "GROQ_API_KEY",
      "capabilities": [
        "draft"
      ],
      "daily_limit": 1000,
      "owner_attested": true,
      "enabled": true
    },
    {
      "id": "openrouter",
      "endpoint": "https://openrouter.ai/api/v1/chat/completions",
      "model": "auto",
      "prefer": [
        ":free$"
      ],
      "secret_env": "OPENROUTER_API_KEY",
      "capabilities": [
        "draft"
      ],
      "daily_limit": 200,
      "owner_attested": true,
      "enabled": true
    },
    {
      "id": "siliconflow",
      "endpoint": "https://api.siliconflow.com/v1/chat/completions",
      "model": "auto",
      "prefer": [
        "Qwen.*(72B|32B|Instruct)",
        "DeepSeek"
      ],
      "secret_env": "SILICONFLOW_API_KEY",
      "capabilities": [
        "draft"
      ],
      "daily_limit": 1000,
      "owner_attested": true,
      "enabled": true
    },
    {
      "id": "gemini",
      "endpoint": "https://generativelanguage.googleapis.com/v1beta/openai/chat/completions",
      "model": "auto",
      "prefer": [
        "gemini-2\\.5-flash$",
        "gemini-2\\.0-flash$",
        "flash"
      ],
      "secret_env": "GEMINI_API_KEY",
      "capabilities": [
        "draft"
      ],
      "daily_limit": 1000,
      "owner_attested": true,
      "enabled": true
    },
    {
      "id": "pollinations",
      "endpoint": "https://text.pollinations.ai/openai/chat/completions",
      "model": "auto",
      "fallback_model": "openai",
      "secret_env": "POLLINATIONS_API_KEY",
      "capabilities": [
        "draft"
      ],
      "daily_limit": 1000,
      "owner_attested": true,
      "enabled": true
    }
  ]
}
