{
  "ci": {
    "collect": {
      "startServerCommand": "PATRO_AUDIT_API=1 PATRO_TLS_KEY=.lighthouseci/localhost.key PATRO_TLS_CERT=.lighthouseci/localhost.crt node scripts/serve-dist.mjs",
      "startServerReadyPattern": "PATRO_STATIC_READY",
      "url": [
        "https://127.0.0.1:4173/",
        "https://127.0.0.1:4173/tools",
        "https://127.0.0.1:4173/fm"
      ],
      "numberOfRuns": 1,
      "settings": { "chromeFlags": ["--ignore-certificate-errors"] }
    },
    "assert": {
      "assertions": {
        "categories:seo": ["error", { "minScore": 0.95 }],
        "categories:accessibility": ["error", { "minScore": 0.9 }],
        "categories:best-practices": ["error", { "minScore": 0.9 }],
        "categories:performance": ["warn", { "minScore": 0.75 }]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
